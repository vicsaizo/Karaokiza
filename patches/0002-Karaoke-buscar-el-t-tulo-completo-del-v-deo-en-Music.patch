         return SongInfo(title=origin_title, artist=origin_artist or "Unknown Artist")
@@ -154,6 +159,23 @@ def __multi_line_search(artist: str, title: str):
     return best
 
 
+def __contained_search(raw: str):
+    """Free search with the whole video title; accept a recording only if its artist AND title are written in it"""
+    haystack = f" {__normalize(raw)} "
+    result = __musicbrainz_request(lambda: musicbrainzngs.search_recordings(query=__clean_string(raw), limit=25))
+    if result is None:
+        return None
+    for record in result['recording-list']:
+        artist, title = __normalize(record['artist-credit-phrase']), __normalize(record['title'])
+        if len(artist) >= 3 and len(title) >= 3 and f" {artist} " in haystack and f" {title} " in haystack:
+            return record
+    return None
+
+
+def __normalize(s: str) -> str:
+    return " ".join(__clean_string(unidecode(s)).split())
+
+
 def __title_similarity(found: str, searched: str) -> float:
     found, searched = __clean_string(found), __clean_string(searched)
     if len(found) >= 4 and (found in searched or searched in found):
