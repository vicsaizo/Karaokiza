+
+# Video title noise like "(Official Video)", "[Lyrics]" or "| Movie Name"
+TITLE_NOISE = re.compile(
+    r"\s*[\(\[][^\)\]]*(official|oficial|video|v[ií]deo|clip|lyric|letra|audio|visualizer|4k|hd)[^\)\]]*[\)\]]",
+    re.IGNORECASE)
+
+
+def __clean_video_title(track: str) -> str:
+    track = re.split(r"\s+[|｜/]\s+", track)[0]
+    track = TITLE_NOISE.sub("", track)
+    track = re.sub(r"\s+(con letra|lyrics?|letra)\s*$", "", track, flags=re.IGNORECASE)
+    track = re.sub(r"\s{2,}", " ", track)
+    return track.strip(" -–—\"'“”«»") or track.strip()
 
 
