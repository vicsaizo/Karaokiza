+def detect_language_by_vote(loaded_whisper_model, audio, max_windows: int = 5) -> str:
+    """Detect the language on the loudest 30s vocal windows instead of only the first 30s.
+
+    Songs often start with an instrumental intro or a short phrase, which makes whisper's
+    first-30s detection unreliable. Probabilities of all windows are summed per language."""
+    from whisperx.audio import N_SAMPLES, log_mel_spectrogram
+    import numpy as np
+
+    windows = [audio[i:i + N_SAMPLES] for i in range(0, max(len(audio) - N_SAMPLES // 2, 1), N_SAMPLES)]
+    loudest = sorted(range(len(windows)), key=lambda i: float(np.sqrt(np.mean(windows[i] ** 2))), reverse=True)
+    n_mels = loaded_whisper_model.model.feat_kwargs.get("feature_size") or 80
+
+    votes: dict[str, float] = {}
+    used = 0
+    for i in sorted(loudest[:max_windows]):
+        window = windows[i]
+        segment = log_mel_spectrogram(window, n_mels=n_mels, padding=max(N_SAMPLES - window.shape[0], 0))
+        encoder_output = loaded_whisper_model.model.encode(segment)
+        for token, probability in loaded_whisper_model.model.model.detect_language(encoder_output)[0][:5]:
+            votes[token[2:-2]] = votes.get(token[2:-2], 0.0) + probability
+        used += 1
+
+    language = max(votes, key=votes.get)
+    confidence = votes[language] / used
+    print(f"{ULTRASINGER_HEAD} Detected language: {language} ({confidence:.2f}) voting over {used} vocal windows")
+    return language
+
+
