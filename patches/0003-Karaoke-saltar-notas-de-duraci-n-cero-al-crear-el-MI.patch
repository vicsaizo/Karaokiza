diff --git a/src/modules/Midi/midi_creator.py b/src/modules/Midi/midi_creator.py
index 97446e1..b712062 100644
--- a/src/modules/Midi/midi_creator.py
+++ b/src/modules/Midi/midi_creator.py
@@ -28,6 +28,8 @@ def create_midi_instrument(midi_segments: list[MidiSegment]) -> object:
     velocity = 100
 
     for i, midi_segment in enumerate(midi_segments):
+        if midi_segment.end <= midi_segment.start:
+            continue  # zero-length notes make pretty_midi raise
         note = pretty_midi.Note(velocity, librosa.note_to_midi(midi_segment.note), midi_segment.start, midi_segment.end)
         instrument.notes.append(note)
 
